void fragment() {
    vec4 color = texture(TEXTURE, UV);
	if (COLOR == vec4(1, 1, 1, 1) || COLOR == vec4(0, 0, 0, 1)){
	 	COLOR = vec4(vec3(1.0) - color.rgb, color.a);
