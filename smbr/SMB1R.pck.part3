uniform vec3 shadow_colour: source_color;
uniform float transparency = 0.0;

void fragment() {
	if (COLOR.a >= 0.025)
	{
		COLOR = vec4(shadow_colour.r, shadow_colour.g, shadow_colour.b, transparency * COLOR.a);
	}
}

