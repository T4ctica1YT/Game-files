extends Node
@onready var bridge: Node2D = $"../Bridge"

func _process(_delta: float) -> void:
	var idx := 0
	for i in bridge.get_children():
		if owner.length > idx:
			i.show()
			i.position.x = idx * -16 + 192
		else:
			i.hide()
			i.global_position.x = -999
		idx += 1
		
