var direction := -1

const MOVE_SPEED := 80

func _physics_process(delta: float) -> void:
	$Sprite.flip_h = direction == 1
	global_position.x += MOVE_SPEED * direction * delta

func damage_player(player: Player) -> void:
	player.damage()
