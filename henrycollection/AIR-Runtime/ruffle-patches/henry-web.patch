+package com.amanitadesign.steam {
+    import flash.events.EventDispatcher;
+    import flash.events.IEventDispatcher;
+    import flash.external.ExternalInterface;
+
+    // Stand-in for the FRESteamWorks AIR native extension (Henry Stickmin web port patch).
+    // Native extensions can't exist on the web, so this reports "Steam is not running":
+    // init() returns false and everything else is a harmless no-op. Achievements are
+    // forwarded to the page (window.__ruffleAirFS("achievement", name)) so it can show them.
+    [API("661")]
+    public class FRESteamWorks extends EventDispatcher {
+        public var isReady:Boolean = false;
+
+        public function FRESteamWorks(target:IEventDispatcher = null) {
+            super(target);
+        }
+
+        public function init():Boolean { return false; }
+        public function dispose():void {}
+        public function runCallbacks():Boolean { return false; }
+        public function isSteamRunning():Boolean { return false; }
+        public function getUserID():String { return ""; }
+        public function getPersonaName():String { return ""; }
+        public function getCurrentGameLanguage():String { return "english"; }
+        public function getAppID():uint { return 0; }
+
+        public function setAchievement(name:String):Boolean {
+            if (ExternalInterface.available) {
+                try {
+                    ExternalInterface.call("__ruffleAirFS", "achievement", name);
+                } catch (e:Error) {
+                }
+            }
+            return false;
+        }
+
+        public function clearAchievement(name:String):Boolean { return false; }
+        public function isAchievement(name:String):Boolean { return false; }
+        public function indicateAchievementProgress(name:String, current:int, max:int):Boolean { return false; }
+        public function storeStats():Boolean { return false; }
+        public function requestStats():Boolean { return false; }
+        public function resetAllStats(achievementsToo:Boolean):Boolean { return false; }
+        public function getStatInt(name:String):int { return 0; }
+        public function getStatFloat(name:String):Number { return 0; }
+        public function setStatInt(name:String, value:int):Boolean { return false; }
+        public function setStatFloat(name:String, value:Number):Boolean { return false; }
+        public function isCloudEnabledForApp():Boolean { return false; }
+        public function isCloudEnabledForAccount():Boolean { return false; }
+        public function setCloudEnabledForApp(enabled:Boolean):Boolean { return false; }
+        public function fileExists(name:String):Boolean { return false; }
+        public function fileRead(name:String, data:*):Boolean { return false; }
+        public function fileWrite(name:String, data:*):Boolean { return false; }
+        public function fileDelete(name:String):Boolean { return false; }
+        public function activateGameOverlay(dialog:String):Boolean { return false; }
+        public function isOverlayEnabled():Boolean { return false; }
+    }
+}
