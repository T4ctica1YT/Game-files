+OBJS    := $(ENGINE:%=$(OUT)/%.o) $(WEBSRC:%=$(OUT)/web/%.o)
+
+LDFLAGS := $(PORTS) -O2 -sMAX_WEBGL_VERSION=2 -sMIN_WEBGL_VERSION=2 -sFULL_ES3=1 -sGL_ENABLE_GET_PROC_ADDRESS=1 \
+           -sALLOW_MEMORY_GROWTH=1 -sINITIAL_MEMORY=512MB -sMAXIMUM_MEMORY=4GB -sSTACK_SIZE=4MB \
+           -sASYNCIFY=1 -sASYNCIFY_STACK_SIZE=262144 \
+           -sFORCE_FILESYSTEM=1 -sCASE_INSENSITIVE_FS=1 -lidbfs.js -sEXIT_RUNTIME=0 -sINVOKE_RUN=0 \
+           -sEXPORTED_RUNTIME_METHODS=FS,IDBFS,callMain,ccall,cwrap \
+           -sEXPORTED_FUNCTIONS=_main,_malloc,_free,_Web_Command,_Web_SaveConfig \
+           -sMODULARIZE=1 -sEXPORT_NAME=createQuakeModule -sENVIRONMENT=web \
+           --pre-js pre.js
+
+all: $(OUT)/qssm.js
+
+$(OUT)/qssm.js: $(OBJS) $(GL4ESLIB) pre.js
+	emcc $(OBJS) $(GL4ESLIB) $(LDFLAGS) -o $@
+
+$(OUT)/%.o: $(SRC)/%.c
+	@mkdir -p $(dir $@)
+	emcc $(CFLAGS) -c $< -o $@
+
+$(OUT)/web/%.o: %.c
+	@mkdir -p $(dir $@)
+	emcc $(CFLAGS) -c $< -o $@
+
+clean:
+	rm -rf $(OUT)
+.PHONY: all clean
+
+-include $(OBJS:.o=.d)
diff --git a/Quake/web/include/curl/curl.h b/Quake/web/include/curl/curl.h
new file mode 100644
index 00000000..8ca2461f
--- /dev/null
+++ b/Quake/web/include/curl/curl.h
@@ -0,0 +1,29 @@
+/* Minimal libcurl stand-in for the Emscripten build.
+ * HTTP map downloads are not available in the browser, so every
+ * transfer fails immediately and callers fall back to their error paths. */
+#ifndef WEB_CURL_STUB_H
+#define WEB_CURL_STUB_H
+
+typedef void CURL;
+typedef long long curl_off_t;
+typedef enum { CURLE_OK = 0, CURLE_FAILED_INIT = 2 } CURLcode;
+typedef enum {
+	CURLOPT_URL, CURLOPT_NOBODY, CURLOPT_TIMEOUT, CURLOPT_TIMEOUT_MS, CURLOPT_NOSIGNAL,
+	CURLOPT_WRITEDATA, CURLOPT_WRITEFUNCTION, CURLOPT_XFERINFODATA, CURLOPT_XFERINFOFUNCTION,
+	CURLOPT_NOPROGRESS, CURLOPT_BUFFERSIZE, CURLOPT_LOW_SPEED_LIMIT, CURLOPT_LOW_SPEED_TIME,
+	CURLOPT_FOLLOWLOCATION, CURLOPT_USERAGENT, CURLOPT_SSL_VERIFYPEER
+} CURLoption;
+typedef enum { CURLINFO_RESPONSE_CODE } CURLINFO;
+
+static inline CURL *curl_easy_init (void) { return 0; }
+static inline CURLcode curl_easy_setopt (CURL *c, CURLoption o, ...) { (void)c; (void)o; return CURLE_FAILED_INIT; }
+static inline CURLcode curl_easy_perform (CURL *c) { (void)c; return CURLE_FAILED_INIT; }
+static inline CURLcode curl_easy_getinfo (CURL *c, CURLINFO i, ...) { (void)c; (void)i; return CURLE_FAILED_INIT; }
+static inline void curl_easy_cleanup (CURL *c) { (void)c; }
+static inline const char *curl_easy_strerror (CURLcode e) { (void)e; return "not available in browser build"; }
+static inline CURLcode curl_global_init (long f) { (void)f; return CURLE_OK; }
+static inline void curl_global_cleanup (void) { }
+#define CURL_GLOBAL_DEFAULT 3
+#define CURL_GLOBAL_ALL 3
+
+#endif
