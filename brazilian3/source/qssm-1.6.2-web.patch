+/*
+================
+Con_DrawTextLine
+
+Draws one console line. UTF-8 sequences (localized text) are drawn as single
+TrueType glyphs, so the rest of the line closes up behind them.
+================
+*/
+static void Con_DrawTextLine (int y, const char *text, float alpha, qboolean fade)
+{
+	unsigned int cp;
+	int x, px, len;
+	qboolean utf8 = UTF8_IsTextN (text, con_linewidth);
+
+	for (x = 0, px = 8; x < con_linewidth; )
+	{
+		len = utf8 ? UTF8_DecodeN (text + x, con_linewidth - x, &cp) : 0;
+		if (len)
+		{
+			const char *ch = text + x;
+			px += Draw_UTF8Char (px, y, &ch, 1, 1, 1, alpha);
+			x += len;
+			continue;
+		}
+		if (fade)
+			Draw_CharacterRGBA (px, y, text[x], CL_PLColours_Parse("0xffffff"), alpha);
+		else
+			Draw_Character (px, y, text[x]);
+		px += 8;
+		x++;
+	}
+}
+
 /*
 ================
 Con_DrawNotify
