diff --git a/Quake/web/shell/index.html b/Quake/web/shell/index.html
new file mode 100644
index 00000000..6cf4643b
--- /dev/null
+++ b/Quake/web/shell/index.html
@@ -0,0 +1,171 @@
+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>AVIAOZINHO 3</title>
+<link rel="icon" href="icon.png">
+<style>
+  :root {
+    --bg: #0b0b0d;
+    --panel: #16161a;
+    --text: #f2efe6;
+    --muted: #a19d92;
+    --accent: #f2c230;
+    --accent-ink: #1a1400;
+    --danger: #ff6b5e;
+    --track: #2a2a30;
+  }
+  * { box-sizing: border-box; }
+  html, body { margin: 0; height: 100%; background: var(--bg); color: var(--text); overflow: hidden;
+    font: 15px/1.45 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
+  /* SDL reads the canvas CSS size on resize, so CSS owns the canvas dimensions. */
+  #canvas { position: fixed; inset: 0; width: 100vw; height: 100vh; display: block; outline: none;
+    background: #000; image-rendering: auto; }
+  #overlay { position: fixed; inset: 0; display: grid; place-items: center; padding: 16px;
+    background: radial-gradient(ellipse at center, #1b1b21 0%, var(--bg) 70%); }
+  #overlay[hidden] { display: none; }
+  .card { width: min(520px, 100%); background: var(--panel); border: 1px solid #26262c; border-radius: 14px;
+    padding: 28px; box-shadow: 0 20px 60px rgba(0,0,0,.5); }
+  h1 { margin: 0 0 4px; font-size: 26px; letter-spacing: .5px; }
+  .sub { margin: 0 0 22px; color: var(--muted); font-size: 13px; }
+  .bar { height: 10px; background: var(--track); border-radius: 99px; overflow: hidden; }
+  .bar > div { height: 100%; width: 0; background: var(--accent); transition: width .15s linear; }
+  #status { margin: 10px 0 20px; color: var(--muted); font-size: 13px; min-height: 1.4em;
+    font-variant-numeric: tabular-nums; }
+  button { font: inherit; font-weight: 700; border: 0; border-radius: 10px; padding: 12px 22px; cursor: pointer; }
+  #play { width: 100%; background: var(--accent); color: var(--accent-ink); font-size: 17px; }
+  #play:disabled { opacity: .35; cursor: progress; }
+  #play:focus-visible, .chip:focus-visible { outline: 3px solid #fff; outline-offset: 2px; }
+  #error { display: none; margin-top: 16px; padding: 12px; border-radius: 8px; background: #2a1414;
+    color: var(--danger); font: 12px/1.5 ui-monospace, Consolas, monospace; white-space: pre-wrap;
+    max-height: 40vh; overflow: auto; }
+  .hint { margin: 16px 0 0; color: var(--muted); font-size: 12px; }
+  #toast { position: fixed; left: 50%; bottom: 24px; transform: translateX(-50%); padding: 10px 16px;
+    border-radius: 99px; background: rgba(10,10,12,.85); color: var(--text); font-size: 13px;
+    pointer-events: none; opacity: 0; transition: opacity .2s; font-variant-numeric: tabular-nums; }
+  #toast.show { opacity: 1; }
+  .chip { position: fixed; top: 12px; right: 12px; background: rgba(10,10,12,.6); color: var(--text);
+    padding: 8px 12px; font-size: 12px; font-weight: 600; opacity: .0; transition: opacity .2s; }
+  body.running:hover .chip { opacity: .8; }
+</style>
+</head>
+<body>
+<canvas id="canvas" tabindex="-1"></canvas>
+
+<div id="overlay">
+  <div class="card">
+    <h1>AVIAOZINHO 3</h1>
+    <p class="sub">Browser build · QSS-M engine compiled to WebAssembly</p>
+    <div class="bar" role="progressbar" aria-label="Download progress"><div id="fill"></div></div>
+    <div id="status">Starting…</div>
+    <button id="play" disabled>Loading…</button>
+    <div id="error" role="alert"></div>
+    <p class="hint">Click the game to capture the mouse. <b>Esc</b> opens the menu (press it twice while the mouse
+      is captured: the first press releases the mouse). Language: Options › Languages. Controllers work too.</p>
+    <p class="hint">The first visit downloads about <span id="size">100 MB</span> of core game data; maps and music
+      stream in as you reach them. Everything is cached, so later visits start fast.
+      Saves and settings are kept in this browser.</p>
+  </div>
+</div>
+<div id="toast" aria-live="polite"></div>
+<button class="chip" id="fs" title="Fullscreen">Fullscreen</button>
+
+<script src="qssm.js"></script>
+<script>
+(function () {
+  const $ = id => document.getElementById(id);
+  const canvas = $('canvas'), fill = $('fill'), status = $('status'), play = $('play');
+  const errBox = $('error'), toast = $('toast'), overlay = $('overlay');
+  const mb = n => (n / 1048576).toFixed(n < 10485760 ? 1 : 0) + ' MB';
+  const log = [];
+
+  function fail(msg) {
+    overlay.hidden = false;
+    document.body.classList.remove('running');
+    play.disabled = true;
+    play.textContent = 'Stopped';
+    errBox.style.display = 'block';
+    errBox.textContent = msg + (log.length ? '\n\n' + log.slice(-12).join('\n') : '');
+  }
+
+  let lazyName = '', lazyGot = 0, toastTimer = 0;
+  function showToast(text) {
+    clearTimeout(toastTimer);
+    toast.textContent = text;
+    toast.classList.add('show');
+  }
+  function hideToast() { toastTimer = setTimeout(() => toast.classList.remove('show'), 400); }
+
+  const moduleArgs = {
+    canvas,
+    print: t => { console.log(t); },
+    printErr: t => { console.warn(t); log.push(t); if (log.length > 200) log.shift(); },
+    onProgress(done, total) {
+      fill.style.width = (total ? 100 * done / total : 0).toFixed(1) + '%';
+      status.textContent = 'Downloading game data… ' + mb(done) + ' / ' + mb(total);
+      $('size').textContent = mb(total);
+    },
+    onLazyStart(path) { lazyName = path.split('/').pop(); lazyGot = 0; showToast('Loading ' + lazyName + '…'); },
+    onLazyProgress(n) { lazyGot += n; showToast('Loading ' + lazyName + ' · ' + mb(lazyGot)); },
+    onLazyEnd() { hideToast(); },
+    onLazyError(path) { showToast('Could not download ' + path); },
+    onAchievement(name) {
+      let got = [];
+      try { got = JSON.parse(localStorage.getItem('aviaozin3-achievements') || '[]'); } catch (e) {}
+      if (got.includes(name)) return;
+      got.push(name);
+      try { localStorage.setItem('aviaozin3-achievements', JSON.stringify(got)); } catch (e) {}
+      const pretty = name.replace(/^ACH(IEVEMENT)?_/i, '').replace(/_/g, ' ').toLowerCase().replace(/\b\w/g, c => c.toUpperCase());
+      showToast('🏆 Achievement unlocked: ' + pretty);
+      setTimeout(hideToast, 4000);
+    },
+    onFatal: fail,
+    onAbort: what => fail('The engine stopped: ' + what),
+    onExit: code => {
+      Module.webSyncPersist && Module.webSyncPersist();
+      if (code) fail('The engine exited with an error (code ' + code + ').');
+      else { overlay.hidden = false; play.disabled = true; play.textContent = 'Game closed — reload the page to play again';
+             document.body.classList.remove('running'); }
+    },
+  };
+  let Module;
+
+  window.addEventListener('error', e => { if (e.message && /abort|RuntimeError/i.test(e.message)) fail(e.message); });
+
+  createQuakeModule(moduleArgs).then(m => {
+    Module = m;
+    window.quake = m; // handy from the devtools console: quake.ccall("Web_Command", null, ["string"], ["map start"])
+    fill.style.width = '100%';
+    status.textContent = 'Ready.';
+    play.disabled = false;
+    play.textContent = 'Play';
+    play.focus();
+  }, e => fail(String(e && e.message || e)));
+
+  play.addEventListener('click', () => {
+    overlay.hidden = true;
+    document.body.classList.add('running');
+    canvas.focus();
+    const w = Math.max(640, innerWidth), h = Math.max(400, innerHeight);
+    const args = ['-basedir', '/game', '-nolan', '-window', '-width', String(w), '-height', String(h)];
+    const extra = new URLSearchParams(location.search).get('args');
+    if (extra) args.push(...extra.split(' ').filter(Boolean));
+    try { Module.callMain(args); }
+    catch (e) { if (e !== 'unwind' && !(e && e.name === 'ExitStatus')) fail(String(e && e.stack || e)); }
+  });
+
+  $('fs').addEventListener('click', () => {
+    (document.fullscreenElement ? document.exitFullscreen() : document.documentElement.requestFullscreen())
+      .catch(() => {});
+    canvas.focus();
+  });
+  canvas.addEventListener('contextmenu', e => e.preventDefault());
+  // Ask before an accidental Ctrl+W / reload throws away unsaved progress.
+  addEventListener('beforeunload', e => {
+    if (document.body.classList.contains('running')) { e.preventDefault(); e.returnValue = ''; }
+  });
+})();
+</script>
+</body>
+</html>
diff --git a/Quake/web/shell/serve.ps1 b/Quake/web/shell/serve.ps1
new file mode 100644
index 00000000..d0c505b7
--- /dev/null
+++ b/Quake/web/shell/serve.ps1
@@ -0,0 +1,46 @@
+# serve.ps1 -- local web server for the AVIAOZINHO 3 browser build.
+# Browsers will not run WebAssembly from file:// pages, so the game must be served over HTTP.
+# Uses .NET's HttpListener, which ships with Windows: nothing to install.
+#
+#   powershell -ExecutionPolicy Bypass -File serve.ps1 [-Port 8080] [-NoBrowser]
+
+param([int]$Port = 8080, [switch]$NoBrowser)
+
+$root = Split-Path -Parent $MyInvocation.MyCommand.Path
+$types = @{ '.html' = 'text/html; charset=utf-8'; '.js' = 'text/javascript'; '.wasm' = 'application/wasm';
+            '.json' = 'application/json'; '.png' = 'image/png'; '.txt' = 'text/plain; charset=utf-8' }
+
+$listener = New-Object System.Net.HttpListener
+$listener.Prefixes.Add("http://localhost:$Port/")
+try { $listener.Start() } catch {
+    Write-Host "Could not listen on port $Port (is it already in use?). Try: serve.ps1 -Port 8081" -ForegroundColor Red
+    exit 1
+}
+$url = "http://localhost:$Port/"
+Write-Host "AVIAOZINHO 3 is running at $url"
+Write-Host "Keep this window open while you play. Close it (or press Ctrl+C) to stop the server."
+if (-not $NoBrowser) { Start-Process $url }
+
+while ($listener.IsListening) {
+    $ctx = $listener.GetContext()
+    $res = $ctx.Response
+    try {
+        $rel = [Uri]::UnescapeDataString($ctx.Request.Url.AbsolutePath).TrimStart('/')
+        if ($rel -eq '') { $rel = 'index.html' }
+        $file = [IO.Path]::GetFullPath((Join-Path $root $rel))
+        if (-not $file.StartsWith($root, [StringComparison]::OrdinalIgnoreCase) -or -not [IO.File]::Exists($file)) {
+            $res.StatusCode = 404
+        } else {
+            $ext = [IO.Path]::GetExtension($file).ToLower()
+            $res.ContentType = if ($types.ContainsKey($ext)) { $types[$ext] } else { 'application/octet-stream' }
+            $res.AddHeader('Cache-Control', 'no-cache')
+            $stream = [IO.File]::OpenRead($file)
+            $res.ContentLength64 = $stream.Length
+            try { $stream.CopyTo($res.OutputStream) } finally { $stream.Dispose() }
+        }
+    } catch {
+        # the browser cancelled a download (e.g. page reloaded); keep serving
+    } finally {
+        try { $res.Close() } catch { }
+    }
+}
diff --git a/Quake/web/web_port.c b/Quake/web/web_port.c
new file mode 100644
index 00000000..a3a21ba6
--- /dev/null
+++ b/Quake/web/web_port.c
@@ -0,0 +1,84 @@
+/*
+web_port.c -- glue between QSS-M and the browser (Emscripten).
+
+- brings up gl4es on top of the WebGL 2 context SDL created
+- fetches large game files (maps, music, fonts) on first use
+- lets the page run console commands (launcher menus, language switch)
+*/
+
+#include "quakedef.h"
+#include <emscripten.h>
+#include <emscripten/html5.h>
+#include <gl4esinit.h>
+
+void *emscripten_GetProcAddress (const char *name);
+
+static void Web_GetMainFBSize (int *width, int *height)
+{
+	emscripten_get_canvas_element_size ("#canvas", width, height);
+}
+
+void Web_InitGL4ES (void)
+{
+	static qboolean initialized;
+
+	if (initialized)
+		return;
+	initialized = true;
+	set_getprocaddress (emscripten_GetProcAddress);
+	set_getmainfbsize (Web_GetMainFBSize);
+	initialize_gl4es ();
+}
+
+/* The scene cache needs a worker thread; the browser build runs without threads. */
+void RSceneCache_Cleanup (qmodel_t *mod) { (void)mod; }
+void RSceneCache_Shutdown (void) { }
+qboolean RSceneCache_HasSky (void) { return false; }
+byte *skipsubmodels; /* owned by the scene cache in r_world.c when threads exist */
+
+/*
+Large files are shipped as zero-length placeholders so directory listings
+still work. The first time the engine opens one, pre.js downloads the real
+contents into the in-memory filesystem. Asyncify suspends the engine while
+the download runs, so callers see an ordinary blocking open.
+*/
+EM_ASYNC_JS(int, Web_FetchLazyFileJS, (const char *path), {
+	return await Module.webFetchLazy(UTF8ToString(path));
+});
+
+EM_JS(int, Web_IsLazyPendingJS, (const char *path), {
+	return Module.webIsLazyPending(UTF8ToString(path)) ? 1 : 0;
+});
+
+void Web_EnsureFile (const char *path)
+{
+	if (Web_IsLazyPendingJS (path))
+		Web_FetchLazyFileJS (path);
+}
+
+EM_JS(void, Web_Achievement, (const char *name), {
+	if (Module.onAchievement) Module.onAchievement(UTF8ToString(name));
+});
+
+/*
+Players close the tab instead of quitting, so the page saves config.cfg itself
+(when the tab is hidden and every so often). Settings such as the language,
+key bindings and volume would otherwise only be written by the quit command.
+*/
+EMSCRIPTEN_KEEPALIVE void Web_SaveConfig (void)
+{
+	extern qboolean host_quietconfig;
+
+	if (!host_initialized)
+		return;
+	host_quietconfig = true;
+	Host_WriteConfiguration ();
+	host_quietconfig = false;
+}
+
+/* Called from the page to queue console commands. */
+EMSCRIPTEN_KEEPALIVE void Web_Command (const char *text)
+{
+	Cbuf_AddText (text);
+	Cbuf_AddText ("\n");
+}
