diff --git a/Quake/aviao_menu.c b/Quake/aviao_menu.c
new file mode 100644
index 00000000..8217fbd1
--- /dev/null
+++ b/Quake/aviao_menu.c
@@ -0,0 +1,774 @@
+/*
+aviao_menu.c -- AVIAOZINHO 3's own menus, rebuilt for the open-source engine.
+
+The game's original executable adds these to QSS-M; they are driven entirely by
+the game's data files:
+
+  Single Player > Levels   Campaign   id1/campaign.json  [{ "name": "1MAPA1.bsp", "data": "$Mapa1" }, ...]
+                           Horde      id1/horde.json     [{ "name": "horda_favela", "data": "description" }, ...]
+                           All Maps   QSS-M's own maps menu
+  How to Play (F1)         How to Play id1/help.json, Lore id1/lore.json
+                           { "Menus": { "Children": [ { "Title": "$key", "Children": [...] } ] } }
+                           a leaf is { "Image": "gfx/x.png", "SubTitle": "$key" }
+  Options > Languages      languages.txt ("Display name,loc_file.txt" per line) and
+                           id1/localization/loc_*.txt, remembered in the "language" cvar
+
+Labels starting with '$' are localization keys. Localized text is UTF-8 and is
+drawn through draw_utf8.c.
+*/
+
+#include "quakedef.h"
+#include "json.h"
+#include "q_ctype.h"
+
+void M_DrawQuakeBar (int x, int y, int cols);
+
+#define MAX_DEPTH		8
+#define MAX_ITEMS		160
+#define LIST_X			40
+#define LIST_Y			40
+#define LIST_COLS		34
+#define LIST_ROWS		17
+#define MAP_LIST_ROWS	14		// leaves room for the selected map's full description
+#define TEXT_TOP		92		// image pages: subtitle text starts below the picture
+#define TEXT_ROWS		13
+
+void M_SetSkillMenuMap (const char *name);
+void M_Menu_Skill_f (void);
+void M_Menu_Maps_f (void);
+void M_Menu_SinglePlayer_f (void);
+void M_Menu_Options_f (void);
+void M_Menu_Main_f (void);
+
+typedef enum { PAGE_CHOICES, PAGE_MAPS, PAGE_TREE, PAGE_IMAGE, PAGE_LANGUAGES } pagekind_t;
+typedef enum { ACT_NONE, ACT_CAMPAIGN, ACT_HORDE, ACT_ALLMAPS, ACT_HOWTOPLAY, ACT_LORE } action_t;
+
+typedef struct
+{
+	char				label[320];		// display text, already localized
+	char				arg[MAX_QPATH];	// map name or localization file
+	action_t			action;
+	const jsonentry_t	*node;			// tree pages: the child object
+} item_t;
+
+typedef struct
+{
+	pagekind_t			kind;
+	char				title[128];
+	item_t				items[MAX_ITEMS];
+	int					numitems;
+	int					cursor, scroll;
+	qboolean			horde;			// map pages: start maps in horde mode
+	const jsonentry_t	*leaf;			// image pages: { Image, SubTitle }
+	int					textscroll;
+} page_t;
+
+static page_t		pages[MAX_DEPTH];
+static int			depth;					// pages[depth-1] is on screen
+static enum m_state_e	exit_state;			// menu to return to from the first page
+static json_t		*help_json, *lore_json;
+
+static void Language_Changed (cvar_t *var);
+static cvar_t language = {"language", "loc_english.txt", CVAR_ARCHIVE};
+
+/* ---------------------------------------------------------------- data files */
+
+static const char *Loc (const char *s)
+{
+	return (s && *s == '$') ? LOC_GetString (s) : (s ? s : "");
+}
+
+static void CopyTrimmed (char *dst, size_t size, const char *src)
+{
+	const char *end;
+
+	while (*src == ' ' || *src == '\t')
+		src++;
+	end = src + strlen (src);
+	while (end > src && (end[-1] == ' ' || end[-1] == '\t' || end[-1] == '\r' || end[-1] == '\n'))
+		end--;
+	q_strlcpy (dst, src, q_min (size, (size_t)(end - src) + 1));
+}
+
+/* The game's JSON files contain trailing commas, which the original parser accepted. */
+static void StripTrailingCommas (char *text)
+{
+	qboolean instring = false;
+	char *p, *q;
+
+	for (p = text; *p; p++)
+	{
+		if (instring)
+		{
+			if (*p == '\\' && p[1])
+				p++;
+			else if (*p == '"')
+				instring = false;
+			continue;
+		}
+		if (*p == '"')
+			instring = true;
+		else if (*p == ',')
+		{
+			for (q = p + 1; *q == ' ' || *q == '\t' || *q == '\r' || *q == '\n'; q++)
+				;
+			if (*q == ']' || *q == '}')
+				*p = ' ';
+		}
+	}
+}
+
+static json_t *LoadJSON (const char *path)
+{
+	char *text;
+	json_t *json;
+
+	text = (char *) COM_LoadMallocFile (path, NULL);
+	if (!text)
+	{
+		Con_Printf ("Couldn't load %s\n", path);
+		return NULL;
+	}
+	StripTrailingCommas (text);
+	json = JSON_Parse (text);
+	free (text);
+	if (!json)
+		Con_Printf ("%s is not valid JSON\n", path);
+	return json;
+}
+
+/* ---------------------------------------------------------------- page stack */
+
+static page_t *CurrentPage (void)
+{
+	return depth ? &pages[depth - 1] : NULL;
+}
+
+static page_t *PushPage (pagekind_t kind, const char *title)
+{
+	page_t *p;
+
+	if (depth == MAX_DEPTH)
+		return NULL;
+	p = &pages[depth++];
+	memset (p, 0, sizeof (*p));
+	p->kind = kind;
+	q_strlcpy (p->title, Loc (title), sizeof (p->title));
+	return p;
+}
+
+static item_t *AddItem (page_t *p, const char *label, const char *arg, action_t action)
+{
+	item_t *it;
+
+	if (p->numitems == MAX_ITEMS)
+		return NULL;
+	it = &p->items[p->numitems++];
+	CopyTrimmed (it->label, sizeof (it->label), Loc (label));
+	q_strlcpy (it->arg, arg ? arg : "", sizeof (it->arg));
+	it->action = action;
+	it->node = NULL;
+	return it;
+}
+
+static void OpenMenu (enum m_state_e from)
+{
+	exit_state = from;
+	key_dest = key_menu;
+	m_state = m_aviao;
+	m_entersound = true;
+	IN_UpdateGrabs ();
+}
+
+static void CloseMenu (void)
+{
+	depth = 0;
+	JSON_Free (help_json);
+	JSON_Free (lore_json);
+	help_json = lore_json = NULL;
+
+	switch (exit_state)
+	{
+	case m_singleplayer:	M_Menu_SinglePlayer_f ();	break;
+	case m_options:			M_Menu_Options_f ();		break;
+	default:				M_Menu_Main_f ();			break;
+	}
+}
+
+static void PopPage (void)
+{
+	S_LocalSound ("misc/menu1.wav");
+	if (depth > 1)
+		depth--;
+	else
+		CloseMenu ();
+}
+
+/* ---------------------------------------------------------------- page builders */
+
+static void PushMapList (const char *jsonfile, const char *title, qboolean horde)
+{
+	json_t *json = LoadJSON (jsonfile);
+	const jsonentry_t *e;
+	page_t *p;
+
+	if (!json)
+		return;
+	if ((p = PushPage (PAGE_MAPS, title)))
+	{
+		p->horde = horde;
+		if (json->root && json->root->type == JSON_ARRAY)
+			for (e = json->root->firstchild; e; e = e->next)
+			{
+				const char *name = JSON_FindString (e, "name");
+				const char *data = JSON_FindString (e, "data");
+				char map[MAX_QPATH];
+
+				if (!name || !*name)
+					continue;
+				COM_StripExtension (name, map, sizeof (map));
+				AddItem (p, data && *data ? data : map, map, ACT_NONE);
+			}
+	}
+	JSON_Free (json);	// labels were copied into the page
+}
+
+static const jsonentry_t *MenuChildren (json_t *json)
+{
+	const jsonentry_t *menus;
+
+	if (!json || !json->root)
+		return NULL;
+	menus = JSON_Find (json->root, "Menus", JSON_OBJECT);
+	return menus ? JSON_Find (menus, "Children", JSON_ARRAY) : NULL;
+}
+
+static void PushTree (const jsonentry_t *children, const char *title)
+{
+	const jsonentry_t *e;
+	page_t *p;
+
+	if (!children || !(p = PushPage (PAGE_TREE, title)))
+		return;
+	for (e = children->firstchild; e; e = e->next)
+	{
+		item_t *it;
+		const char *t = JSON_FindString (e, "Title");
+		if (!t)
+			continue;
+		if ((it = AddItem (p, t, NULL, ACT_NONE)))
+			it->node = e;
+	}
+}
+
+/* A tree node either has more titled children (a sub-menu) or one leaf with an image. */
+static void EnterTreeNode (const jsonentry_t *node)
+{
+	const jsonentry_t *children = JSON_Find (node, "Children", JSON_ARRAY);
+	const jsonentry_t *first = children ? children->firstchild : NULL;
+	page_t *p;
+
+	if (!first)
+		return;
+	if (JSON_FindString (first, "Image") || JSON_FindString (first, "SubTitle"))
+	{
+		if ((p = PushPage (PAGE_IMAGE, JSON_FindString (node, "Title"))))
+			p->leaf = first;
+	}
+	else
+		PushTree (children, JSON_FindString (node, "Title"));
+}
+
+/* languages.txt ships in the Windows ANSI code page (Latin-1 here); menus expect UTF-8. */
+static void Latin1ToUTF8 (char *dst, size_t size, const char *src)
+{
+	size_t n = 0;
+
+	for (; *src && n + 2 < size; src++)
+	{
+		byte c = (byte)*src;
+		if (c < 0x80)
+			dst[n++] = c;
+		else
+		{
+			dst[n++] = 0xC0 | (c >> 6);
+			dst[n++] = 0x80 | (c & 0x3F);
+		}
+	}
+	dst[n] = 0;
+}
+
+static void PushLanguages (void)
+{
+	char *text, *line, *next;
+	page_t *p;
+
+	// like the original executable, read it from the install directory, not a game directory
+	text = (char *) COM_LoadMallocFile_TextMode_OSPath (va ("%s/languages.txt", com_basedir), NULL);
+	if (!text)
+	{
+		Con_Printf ("Couldn't load languages.txt\n");
+		return;
+	}
+	if ((p = PushPage (PAGE_LANGUAGES, "$menu_languages")))
+	{
+		for (line = text; line && *line; line = next)
+		{
+			char name[256], file[MAX_QPATH], utf8[512];
+			char *comma;
+			const char *s;
+
+			next = strchr (line, '\n');
+			if (next)
+				*next++ = 0;
+			comma = strrchr (line, ',');
+			if (!comma)
+				continue;
+			*comma = 0;
+			for (s = line; *s && (byte)*s < 0x80; s++)
+				;
+			if (*s && !UTF8_IsText (line))
+			{	// has non-ASCII bytes that are not UTF-8: convert from the ANSI code page
+				Latin1ToUTF8 (utf8, sizeof (utf8), line);
+				line = utf8;
+			}
+			CopyTrimmed (name, sizeof (name), line);
+			CopyTrimmed (file, sizeof (file), comma + 1);
+			if (!*name || !*file)
+				continue;
+			AddItem (p, name, file, ACT_NONE);
+			if (!q_strcasecmp (file, language.string))
+				p->cursor = p->numitems - 1;
+		}
+	}
+	free (text);
+}
+
+/* ---------------------------------------------------------------- entry points */
+
+void AviaoMenu_Levels_f (void)
+{
+	page_t *p;
+
+	depth = 0;
+	if (!(p = PushPage (PAGE_CHOICES, "$menu_single_player")))
+		return;
+	AddItem (p, "$menu_campaign", NULL, ACT_CAMPAIGN);
+	AddItem (p, "$menu_horde", NULL, ACT_HORDE);
+	AddItem (p, "$menu_all_maps", NULL, ACT_ALLMAPS);
+	OpenMenu (m_singleplayer);
+}
+
+void AviaoMenu_Help_f (void)
+{
+	page_t *p;
+
+	depth = 0;
+	if (!(p = PushPage (PAGE_CHOICES, "$menu_lore_how_to_play")))
+		return;
+	AddItem (p, "$menu_how_to_play", NULL, ACT_HOWTOPLAY);
+	AddItem (p, "$menu_lore", NULL, ACT_LORE);
+	OpenMenu (m_main);
+}
+
+void AviaoMenu_Languages_f (void)
+{
+	depth = 0;
+	PushLanguages ();
+	if (depth)
+		OpenMenu (m_options);
+}
+
+/* ---------------------------------------------------------------- actions */
+
+static void StartMap (const char *map, qboolean horde)
+{
+	// the game's QuakeC (rerelease based) reads these to pick campaign or horde rules
+	Cbuf_AddText (va ("horde %d\ncampaign %d\n", horde ? 1 : 0, horde ? 0 : 1));
+	M_SetSkillMenuMap (map);
+	M_Menu_Skill_f ();	// pressing escape there comes back to this page
+}
+
+static void Activate (void)
+{
+	page_t *p = CurrentPage ();
+	item_t *it;
+
+	if (!p || p->kind == PAGE_IMAGE || p->cursor >= p->numitems)
+		return;
+	it = &p->items[p->cursor];
+	m_entersound = true;
+
+	switch (p->kind)
+	{
+	case PAGE_CHOICES:
+		switch (it->action)
+		{
+		case ACT_CAMPAIGN:	PushMapList ("campaign.json", "$menu_campaign", false);	break;
+		case ACT_HORDE:		PushMapList ("horde.json", "$menu_horde", true);		break;
+		case ACT_ALLMAPS:
+			Cbuf_AddText ("horde 0\ncampaign 0\n");
+			M_Menu_Maps_f ();
+			break;
+		case ACT_HOWTOPLAY:
+			if (!help_json)
+				help_json = LoadJSON ("help.json");
+			PushTree (MenuChildren (help_json), "$menu_how_to_play");
+			break;
+		case ACT_LORE:
+			if (!lore_json)
+				lore_json = LoadJSON ("lore.json");
+			PushTree (MenuChildren (lore_json), "$menu_lore");
+			break;
+		default:
+			break;
+		}
+		break;
+
+	case PAGE_MAPS:
+		StartMap (it->arg, p->horde);
+		break;
+
+	case PAGE_TREE:
+		if (it->node)
+			EnterTreeNode (it->node);
+		break;
+
+	case PAGE_LANGUAGES:
+		Cvar_Set ("language", it->arg);
+		PopPage ();
+		break;
+
+	default:
+		break;
+	}
+}
+
+/* Image pages: left/right step through the other entries of the same list. */
+static void ClampScroll (page_t *p);
+
+static void StepImage (int dir)
+{
+	page_t *list;
+
+	if (depth < 2 || CurrentPage ()->kind != PAGE_IMAGE)
+		return;
+	list = &pages[depth - 2];
+	if (list->kind != PAGE_TREE || list->numitems < 2)
+		return;
+	list->cursor = (list->cursor + dir + list->numitems) % list->numitems;
+	ClampScroll (list);
+	depth--;		// replace this page with the neighbour's
+	Activate ();
+	S_LocalSound ("misc/menu1.wav");
+}
+
+/* ---------------------------------------------------------------- input */
+
+static int VisibleRows (const page_t *p)
+{
+	return p->kind == PAGE_MAPS ? MAP_LIST_ROWS : LIST_ROWS;
+}
+
+static void ClampScroll (page_t *p)
+{
+	int rows = VisibleRows (p);
+
+	if (p->cursor < p->scroll)
+		p->scroll = p->cursor;
+	else if (p->cursor >= p->scroll + rows)
+		p->scroll = p->cursor - rows + 1;
+	p->scroll = CLAMP (0, p->scroll, q_max (0, p->numitems - rows));
+}
+
+void AviaoMenu_Key (int key)
+{
+	page_t *p = CurrentPage ();
+
+	if (!p)
+	{
+		CloseMenu ();
+		return;
+	}
+
+	switch (key)
+	{
+	case K_ESCAPE:
+	case K_BBUTTON:
+	case K_MOUSE2:
+	case K_MOUSE4:
+		PopPage ();
+		return;
+
+	case K_ENTER:
+	case K_KP_ENTER:
+	case K_ABUTTON:
+	case K_MOUSE1:
+		Activate ();
+		return;
+	}
+
+	if (p->kind == PAGE_IMAGE)
+	{
+		switch (key)
+		{
+		case K_LEFTARROW:	StepImage (-1);	break;
+		case K_RIGHTARROW:	StepImage (1);	break;
+		case K_UPARROW:
+		case K_MWHEELUP:
+			if (p->textscroll > 0)
+				p->textscroll--;
+			break;
+		case K_DOWNARROW:
+		case K_MWHEELDOWN:
+			p->textscroll++;	// clamped while drawing
+			break;
+		}
+		return;
+	}
+
+	if (!p->numitems)
+		return;
+
+	switch (key)
+	{
+	case K_UPARROW:
+	case K_MWHEELUP:
+		S_LocalSound ("misc/menu1.wav");
+		if (--p->cursor < 0)
+			p->cursor = p->numitems - 1;
+		break;
+	case K_DOWNARROW:
+	case K_MWHEELDOWN:
+		S_LocalSound ("misc/menu1.wav");
+		if (++p->cursor >= p->numitems)
+			p->cursor = 0;
+		break;
+	case K_PGUP:
+		S_LocalSound ("misc/menu1.wav");
+		p->cursor = q_max (0, p->cursor - VisibleRows (p));
+		break;
+	case K_PGDN:
+		S_LocalSound ("misc/menu1.wav");
+		p->cursor = q_min (p->numitems - 1, p->cursor + VisibleRows (p));
+		break;
+	case K_HOME:
+		S_LocalSound ("misc/menu1.wav");
+		p->cursor = 0;
+		break;
+	case K_END:
+		S_LocalSound ("misc/menu1.wav");
+		p->cursor = p->numitems - 1;
+		break;
+	default:
+		return;
+	}
+	ClampScroll (p);
+}
+
+void AviaoMenu_Mousemove (int x, int y)
+{
+	page_t *p = CurrentPage ();
+	int row;
+
+	(void)x;
+	if (!p || p->kind == PAGE_IMAGE || y < LIST_Y)
+		return;
+	row = (y - LIST_Y) / 8;
+	if (row < VisibleRows (p) && p->scroll + row < p->numitems)
+		p->cursor = p->scroll + row;
+}
+
+/* ---------------------------------------------------------------- drawing */
+
+/* Copies as much of src as fits in maxcells display cells; returns bytes used. */
+static int FitCells (char *dst, size_t size, const char *src, int maxcells)
+{
+	int used = 0, cells = 0;
+
+	while (src[used] && src[used] != '\n')
+	{
+		unsigned int cp;
+		int len = UTF8_Decode (src + used, &cp);
+		int w;
+
+		if (!len)
+			len = 1;
+		w = UTF8_TextWidthN (src + used, len);
+		if (cells + w > maxcells || (size_t)(used + len) >= size)
+			break;
+		cells += w;
+		used += len;
+	}
+	memcpy (dst, src, used);
+	dst[used] = 0;
+	return used;
+}
+
+/* Word-wraps text (honouring embedded newlines) into lines of at most cols cells. */
+static int WrapText (const char *text, int cols, char lines[][256], int maxlines)
+{
+	int n = 0;
+
+	while (*text && n < maxlines)
+	{
+		int len = FitCells (lines[n], sizeof (lines[n]), text, cols);
+
+		if (text[len] && text[len] != '\n')
+		{	// break at the last space instead of mid-word
+			int cut = len;
+			while (cut > 0 && text[cut] != ' ')
+				cut--;
+			if (cut > 0)
+			{
+				len = cut;
+				lines[n][len] = 0;
+			}
+		}
+		{	// trim the line
+			char tmp[256];
+			CopyTrimmed (tmp, sizeof (tmp), lines[n]);
+			q_strlcpy (lines[n], tmp, sizeof (lines[n]));
+		}
+		n++;
+		text += len;
+		while (*text == ' ')
+			text++;
+		if (*text == '\n')
+			text++;
+	}
+	return n;
+}
+
+static void PrintCentered (int y, const char *text, qboolean white)
+{
+	int x = (320 - UTF8_TextWidth (text) * 8) / 2;
+
+	if (white)
+		M_PrintWhite (x, y, text);
+	else
+		M_Print (x, y, text);
+}
+
+static void DrawImagePage (page_t *p)
+{
+	const char *image = JSON_FindString (p->leaf, "Image");
+	const char *subtitle = Loc (JSON_FindString (p->leaf, "SubTitle"));
+	static char lines[64][256];
+	int i, n, maxscroll;
+
+	if (image && *image)
+	{
+		qpic_t *pic = Draw_TryCachePic (image, TEXPREF_ALPHA | TEXPREF_PAD | TEXPREF_NOPICMIP);
+		if (pic)
+			M_DrawPic ((320 - pic->width) / 2, (200 - pic->height) / 2, pic);
+	}
+
+	n = WrapText (subtitle, 38, lines, 64);
+	maxscroll = q_max (0, n - TEXT_ROWS);
+	p->textscroll = CLAMP (0, p->textscroll, maxscroll);
+	for (i = 0; i < TEXT_ROWS && i + p->textscroll < n; i++)
+		PrintCentered (TEXT_TOP + i * 8, lines[i + p->textscroll], false);
+
+	if (p->textscroll > 0)
+		M_DrawCharacter (304, TEXT_TOP, '^' | 128);
+	if (p->textscroll < maxscroll)
+		M_DrawCharacter (304, TEXT_TOP + (TEXT_ROWS - 1) * 8, 'v' | 128);
+	if (depth >= 2 && pages[depth - 2].kind == PAGE_TREE && pages[depth - 2].numitems > 1)
+	{	// left/right flip through the rest of the list
+		M_DrawCharacter (4, 96, '<' | 128);
+		M_DrawCharacter (308, 96, '>' | 128);
+	}
+}
+
+void AviaoMenu_Draw (void)
+{
+	page_t *p = CurrentPage ();
+	int i, rows;
+	char buf[256];
+
+	if (!p)
+		return;
+
+	if (p->kind == PAGE_IMAGE)
+	{
+		DrawImagePage (p);
+		return;
+	}
+
+	PrintCentered (12, p->title, true);
+	M_DrawQuakeBar (LIST_X - 16, 24, LIST_COLS + 4);
+
+	rows = VisibleRows (p);
+	ClampScroll (p);
+	for (i = 0; i < rows && p->scroll + i < p->numitems; i++)
+	{
+		int idx = p->scroll + i;
+		int y = LIST_Y + i * 8;
+		qboolean selected = (idx == p->cursor);
+		const item_t *it = &p->items[idx];
+
+		FitCells (buf, sizeof (buf), it->label, LIST_COLS);
+		M_Print (LIST_X, y, buf);
+		if (selected)
+			M_DrawCharacter (LIST_X - 10, y, 12 + ((int)(realtime * 4) & 1));
+
+		if (p->kind == PAGE_LANGUAGES && !q_strcasecmp (it->arg, language.string))
+			M_DrawCharacter (LIST_X - 20, y, 131);	// current language
+	}
+
+	if (p->scroll > 0)
+		M_DrawCharacter (LIST_X + LIST_COLS * 8 + 4, LIST_Y, '^' | 128);
+	if (p->scroll + rows < p->numitems)
+		M_DrawCharacter (LIST_X + LIST_COLS * 8 + 4, LIST_Y + (rows - 1) * 8, 'v' | 128);
+
+	if (p->kind == PAGE_MAPS && p->cursor < p->numitems)
+	{	// the full description of the selected map, plus its file name
+		static char lines[4][256];
+		int n = WrapText (p->items[p->cursor].label, 38, lines, 3);
+
+		M_DrawQuakeBar (LIST_X - 16, LIST_Y + rows * 8 + 2, LIST_COLS + 4);
+		for (i = 0; i < n; i++)
+			PrintCentered (LIST_Y + rows * 8 + 12 + i * 8, lines[i], false);
+		PrintCentered (LIST_Y + rows * 8 + 14 + n * 8, p->items[p->cursor].arg, true);	// file name, secondary colour
+	}
+}
+
+/* ---------------------------------------------------------------- language */
+
+static qboolean ValidLanguageFile (const char *s)
+{
+	const char *c;
+
+	if (q_strncasecmp (s, "loc_", 4) || strlen (s) < 9 || q_strcasecmp (s + strlen (s) - 4, ".txt"))
+		return false;
+	for (c = s; *c; c++)
+		if (!q_isalnum (*c) && *c != '_' && *c != '-' && *c != '.')
+			return false;
+	return true;
+}
+
+static void Language_Changed (cvar_t *var)
+{
+	if (!ValidLanguageFile (var->string))
+	{
+		Con_Printf ("language: \"%s\" is not a localization file\n", var->string);
+		return;
+	}
+	LOC_LoadFile (va ("localization/%s", var->string));
+	if (!LOC_GetRawString ("$menu_quit"))
+	{
+		Con_Printf ("Language '%s' could not be loaded\nFalling back to localization/loc_english.txt\n", var->string);
+		LOC_LoadFile ("localization/loc_english.txt");
+	}
+	Draw_UTF8Reset ();
+}
+
+void AviaoMenu_Init (void)
+{
+	Cvar_RegisterVariable (&language);
+	Cvar_SetCallback (&language, Language_Changed);
+	Cmd_AddCommand ("menu_languages", AviaoMenu_Languages_f);
+	Cmd_AddCommand ("menu_lore", AviaoMenu_Help_f);
+	Cmd_AddCommand ("menu_levels", AviaoMenu_Levels_f);
+}
diff --git a/Quake/draw_utf8.c b/Quake/draw_utf8.c
new file mode 100644
index 00000000..50e2eb6d
--- /dev/null
+++ b/Quake/draw_utf8.c
@@ -0,0 +1,458 @@
+/*
+draw_utf8.c -- UTF-8 text drawn with TrueType glyphs.
+
+Quake's conchars only cover its own 8-bit character set, but AVIAOZINHO 3's
+localization files are UTF-8 (Portuguese accents, Cyrillic, Chinese, Japanese,
+Korean...). Any UTF-8 sequence found in drawn text is rasterized on demand from
+fonts/font0.ttf, falling back to fonts/font1.ttf (CJK), into a glyph atlas and
+drawn in the same 8x8 cells as conchars. Wide (CJK) glyphs take two cells.
+
+Text drawing loops call Draw_UTF8Char() first; it returns 0 for plain Quake
+characters so the loop can draw them as before.
+*/
+
+#include "quakedef.h"
+
+#define STB_TRUETYPE_IMPLEMENTATION
+#define STBTT_STATIC
+#include "stb_truetype.h"
+
+#define ATLAS_SIZE		1024
+#define CELL_PX			32		// texels per 8-pixel cell
+#define SLOT_PAD		(CELL_PX / 4)	// headroom above and below the cell for accents and descenders
+#define SLOT_H			(CELL_PX + 2 * SLOT_PAD)
+#define HASH_SIZE		4096
+#define MAX_GLYPHS		((ATLAS_SIZE / CELL_PX) * (ATLAS_SIZE / SLOT_H))
+#define NUM_FONTS		2
+
+typedef struct
+{
+	unsigned int	codepoint;
+	short			x, y;		// atlas position in texels
+	byte			cells;		// 1 normal, 2 wide
+} glyph_t;
+
+static const char *font_files[NUM_FONTS] = { "fonts/font0.ttf", "fonts/font1.ttf" };
+
+static struct
+{
+	stbtt_fontinfo	info[NUM_FONTS];
+	byte			*data[NUM_FONTS];
+	int				state[NUM_FONTS];	// 0 not tried, 1 loaded, -1 unavailable
+	float			scale[NUM_FONTS];
+	int				baseline[NUM_FONTS];
+
+	gltexture_t		*tex;
+	byte			*pixels;			// RGBA atlas, also the texture's reload source
+	int				dirty_y0, dirty_y1;	// rows to upload, y0 >= y1 when clean
+	int				pen_x, pen_y;
+
+	glyph_t			glyphs[MAX_GLYPHS];
+	int				numglyphs;
+	int				hash[HASH_SIZE];	// glyph index + 1
+} ft;
+
+/*
+================
+UTF8_Decode
+
+Decodes one well-formed UTF-8 sequence. Returns its length in bytes, or 0 when
+*s is not the start of one (plain ASCII or Quake's own high-bit characters).
+================
+*/
+int UTF8_DecodeN (const char *str, int maxlen, unsigned int *codepoint)
+{
+	const byte *s = (const byte *)str;
+	unsigned int cp;
+	int len, i;
+
+	if (maxlen < 2 || s[0] < 0xC2 || s[0] > 0xF4)
+		return 0;
+	if (s[0] < 0xE0)		{ len = 2; cp = s[0] & 0x1F; }
+	else if (s[0] < 0xF0)	{ len = 3; cp = s[0] & 0x0F; }
+	else					{ len = 4; cp = s[0] & 0x07; }
+	if (len > maxlen)
+		return 0;
+
+	for (i = 1; i < len; i++)
+	{
+		if ((s[i] & 0xC0) != 0x80)
+			return 0;
+		cp = (cp << 6) | (s[i] & 0x3F);
+	}
+	if ((len == 3 && cp < 0x800) || (len == 4 && (cp < 0x10000 || cp > 0x10FFFF)) || (cp >= 0xD800 && cp <= 0xDFFF))
+		return 0;
+
+	*codepoint = cp;
+	return len;
+}
+
+int UTF8_Decode (const char *str, unsigned int *codepoint)
+{
+	// strings are NUL-terminated and NUL fails the continuation-byte check
+	return UTF8_DecodeN (str, 4, codepoint);
+}
+
+static qboolean UTF8_IsWide (unsigned int cp)
+{
+	return (cp >= 0x1100 && cp <= 0x115F) ||	// Hangul Jamo
+		(cp >= 0x2E80 && cp <= 0xA4CF) ||		// CJK radicals .. Yi
+		(cp >= 0xAC00 && cp <= 0xD7A3) ||		// Hangul syllables
+		(cp >= 0xF900 && cp <= 0xFAFF) ||		// CJK compatibility ideographs
+		(cp >= 0xFE30 && cp <= 0xFE4F) ||		// CJK compatibility forms
+		(cp >= 0xFF00 && cp <= 0xFF60) ||		// fullwidth forms
+		(cp >= 0xFFE0 && cp <= 0xFFE6) ||
+		(cp >= 0x1F300 && cp <= 0x1FAFF) ||		// emoji
+		(cp >= 0x20000 && cp <= 0x3FFFD);		// CJK extensions
+}
+
+/*
+================
+UTF8_TextWidth
+
+Width of a string in 8-pixel cells, counting each UTF-8 character once
+(twice for wide characters) instead of once per byte.
+================
+*/
+/*
+================
+UTF8_IsTextN
+
+True when the text contains UTF-8 characters and every byte >= 0x80 belongs to
+one. Quake's own "gold" text sets the high bit on plain characters, and some of
+those byte pairs happen to be valid UTF-8 (gold letter + gold digit), so text is
+only treated as UTF-8 when the whole string decodes cleanly.
+================
+*/
+qboolean UTF8_IsTextN (const char *str, int bytes)
+{
+	qboolean multibyte = false;
+	unsigned int cp;
+	int len;
+
+	while (bytes > 0 && *str)
+	{
+		if ((byte)*str < 0x80)
+			len = 1;
+		else if ((len = UTF8_DecodeN (str, bytes, &cp)))
+			multibyte = true;
+		else
+			return false;
+		str += len;
+		bytes -= len;
+	}
+	return multibyte;
+}
+
+qboolean UTF8_IsText (const char *str)
+{
+	return UTF8_IsTextN (str, (int)strlen (str));
+}
+
+int UTF8_TextWidthN (const char *str, int bytes)
+{
+	int cells = 0, len;
+	unsigned int cp;
+
+	while (bytes > 0 && *str)
+	{
+		len = UTF8_DecodeN (str, bytes, &cp);
+		if (len)
+			cells += UTF8_IsWide (cp) ? 2 : 1;
+		else
+		{
+			cells++;
+			len = 1;
+		}
+		str += len;
+		bytes -= len;
+	}
+	return cells;
+}
+
+int UTF8_TextWidth (const char *str)
+{
+	return UTF8_TextWidthN (str, (int)strlen (str));
+}
+
+static qboolean Font_Load (int f)
+{
+	int ascent, descent, gap;
+
+	if (ft.state[f])
+		return ft.state[f] > 0;
+
+	ft.state[f] = -1;
+	ft.data[f] = COM_LoadMallocFile (font_files[f], NULL);
+	if (!ft.data[f])
+	{
+		Con_DPrintf ("Font_Load: couldn't load %s\n", font_files[f]);
+		return false;
+	}
+	if (!stbtt_InitFont (&ft.info[f], ft.data[f], stbtt_GetFontOffsetForIndex (ft.data[f], 0)))
+	{
+		Con_Printf ("Font_Load: %s is not a usable TrueType font\n", font_files[f]);
+		free (ft.data[f]);
+		ft.data[f] = NULL;
+		return false;
+	}
+
+	// size glyphs so ascender..descender fills the cell, like conchars
+	stbtt_GetFontVMetrics (&ft.info[f], &ascent, &descent, &gap);
+	ft.scale[f] = (float)CELL_PX / (float)(ascent - descent);
+	ft.baseline[f] = (int)(ascent * ft.scale[f] + 0.5f);
+	ft.state[f] = 1;
+	return true;
+}
+
+static void Atlas_Init (void)
+{
+	if (ft.pixels)
+		return;
+	ft.pixels = (byte *) calloc (ATLAS_SIZE * ATLAS_SIZE, 4);
+	if (!ft.pixels)
+		Sys_Error ("Atlas_Init: out of memory");
+	ft.tex = TexMgr_LoadImage (NULL, "utf8_glyphs", ATLAS_SIZE, ATLAS_SIZE, SRC_RGBA, ft.pixels, "",
+							   (src_offset_t)ft.pixels, TEXPREF_ALPHA | TEXPREF_LINEAR | TEXPREF_NOPICMIP | TEXPREF_PERSIST | TEXPREF_CLAMP);
+	ft.dirty_y0 = ATLAS_SIZE;
+	ft.dirty_y1 = 0;
+}
+
+static void Atlas_Clear (void)
+{
+	memset (ft.pixels, 0, ATLAS_SIZE * ATLAS_SIZE * 4);
+	memset (ft.hash, 0, sizeof (ft.hash));
+	ft.numglyphs = 0;
+	ft.pen_x = ft.pen_y = 0;
+	ft.dirty_y0 = 0;
+	ft.dirty_y1 = ATLAS_SIZE;
+}
+
+static glyph_t *Glyph_Find (unsigned int cp)
+{
+	unsigned int h = (cp * 2654435761u) % HASH_SIZE;
+
+	while (ft.hash[h])
+	{
+		glyph_t *g = &ft.glyphs[ft.hash[h] - 1];
+		if (g->codepoint == cp)
+			return g;
+		h = (h + 1) % HASH_SIZE;
+	}
+	return NULL;
+}
+
+static glyph_t *Glyph_Add (unsigned int cp)
+{
+	int f, glyph = 0, cells, w, h, x0, y0, x1, y1, ox, oy, i, j;
+	unsigned int hash;
+	byte *bitmap;
+	glyph_t *g;
+
+	for (f = 0; f < NUM_FONTS; f++)
+	{
+		if (!Font_Load (f))
+			continue;
+		glyph = stbtt_FindGlyphIndex (&ft.info[f], cp);
+		if (glyph)
+			break;
+	}
+	if (f == NUM_FONTS)
+		return NULL;
+
+	cells = UTF8_IsWide (cp) ? 2 : 1;
+	if (ft.pen_x + cells * CELL_PX > ATLAS_SIZE)
+	{
+		ft.pen_x = 0;
+		ft.pen_y += SLOT_H;
+	}
+	if (ft.pen_y + SLOT_H > ATLAS_SIZE || ft.numglyphs == MAX_GLYPHS)
+		Atlas_Clear ();	// rare: more distinct characters on screen than fit; start over
+
+	g = &ft.glyphs[ft.numglyphs++];
+	g->codepoint = cp;
+	g->x = ft.pen_x;
+	g->y = ft.pen_y;
+	g->cells = cells;
+	ft.pen_x += cells * CELL_PX;
+
+	hash = (cp * 2654435761u) % HASH_SIZE;
+	while (ft.hash[hash])
+		hash = (hash + 1) % HASH_SIZE;
+	ft.hash[hash] = ft.numglyphs;
+
+	bitmap = stbtt_GetGlyphBitmap (&ft.info[f], ft.scale[f], ft.scale[f], glyph, &w, &h, &x0, &y0);
+	if (bitmap)
+	{
+		stbtt_GetGlyphBitmapBox (&ft.info[f], glyph, ft.scale[f], ft.scale[f], &x0, &y0, &x1, &y1);
+		ox = (cells * CELL_PX - w) / 2;
+		oy = SLOT_PAD + ft.baseline[f] + y0;
+		for (j = 0; j < h; j++)
+		{
+			int ty = oy + j;
+			if (ty < 0 || ty >= SLOT_H)
+				continue;
+			for (i = 0; i < w; i++)
+			{
+				int tx = ox + i;
+				byte *p;
+				if (tx < 0 || tx >= cells * CELL_PX)
+					continue;
+				p = ft.pixels + ((g->y + ty) * ATLAS_SIZE + g->x + tx) * 4;
+				p[0] = p[1] = p[2] = 255;
+				p[3] = bitmap[j * w + i];
+			}
+		}
+		stbtt_FreeBitmap (bitmap, NULL);
+	}
+
+	ft.dirty_y0 = q_min (ft.dirty_y0, g->y);
+	ft.dirty_y1 = q_max (ft.dirty_y1, g->y + SLOT_H);
+	return g;
+}
+
+static void Atlas_Upload (void)
+{
+	if (ft.dirty_y0 >= ft.dirty_y1)
+		return;
+	GL_Bind (ft.tex);
+	glTexSubImage2D (GL_TEXTURE_2D, 0, 0, ft.dirty_y0, ATLAS_SIZE, ft.dirty_y1 - ft.dirty_y0,
+					 GL_RGBA, GL_UNSIGNED_BYTE, ft.pixels + ft.dirty_y0 * ATLAS_SIZE * 4);
+	ft.dirty_y0 = ATLAS_SIZE;
+	ft.dirty_y1 = 0;
+}
+
+/*
+================
+Draw_UTF8Char
+
+If *str starts a UTF-8 sequence, draws it at (x, y) in the given colour,
+advances *str past it and returns the width drawn in pixels. Otherwise returns
+0 and leaves *str alone. Must not be called between glBegin and glEnd.
+================
+*/
+int Draw_UTF8Char (int x, int y, const char **str, float r, float g, float b, float a)
+{
+	unsigned int cp;
+	glyph_t *glyph;
+	int len, w;
+	float s0, t0, s1, t1, top, bottom;
+
+	len = UTF8_Decode (*str, &cp);
+	if (!len)
+		return 0;
+	*str += len;
+
+	Atlas_Init ();
+	glyph = Glyph_Find (cp);
+	if (!glyph)
+		glyph = Glyph_Add (cp);
+	if (!glyph)
+	{
+		w = UTF8_IsWide (cp) ? 16 : 8;
+		return w;	// no font has it: leave a blank cell rather than mojibake
+	}
+	Atlas_Upload ();
+
+	w = glyph->cells * 8;
+	s0 = (float)glyph->x / ATLAS_SIZE;
+	t0 = (float)glyph->y / ATLAS_SIZE;
+	s1 = (float)(glyph->x + glyph->cells * CELL_PX) / ATLAS_SIZE;
+	t1 = (float)(glyph->y + SLOT_H) / ATLAS_SIZE;
+
+	glEnable (GL_BLEND);
+	glDisable (GL_ALPHA_TEST);
+	glTexEnvf (GL_TEXTURE_ENV, GL_TEXTURE_ENV_MODE, GL_MODULATE);
+	GL_Bind (ft.tex);
+	top = y - SLOT_PAD * 8.0f / CELL_PX;	// the slot overhangs the 8x8 cell for accents
+	bottom = top + SLOT_H * 8.0f / CELL_PX;
+	glBegin (GL_QUADS);
+	// soft drop shadow so thin glyphs stay readable over busy backgrounds, like conchars' dark edges
+	glColor4f (0, 0, 0, a * 0.7f);
+	glTexCoord2f (s0, t0); glVertex2f (x + 0.75f, top + 0.75f);
+	glTexCoord2f (s1, t0); glVertex2f (x + w + 0.75f, top + 0.75f);
+	glTexCoord2f (s1, t1); glVertex2f (x + w + 0.75f, bottom + 0.75f);
+	glTexCoord2f (s0, t1); glVertex2f (x + 0.75f, bottom + 0.75f);
+	glColor4f (r, g, b, a);
+	glTexCoord2f (s0, t0); glVertex2f (x, top);
+	glTexCoord2f (s1, t0); glVertex2f (x + w, top);
+	glTexCoord2f (s1, t1); glVertex2f (x + w, bottom);
+	glTexCoord2f (s0, t1); glVertex2f (x, bottom);
+	glEnd ();
+	glTexEnvf (GL_TEXTURE_ENV, GL_TEXTURE_ENV_MODE, GL_REPLACE);
+	glEnable (GL_ALPHA_TEST);
+	glDisable (GL_BLEND);
+	glColor4f (1, 1, 1, 1);
+
+	return w;
+}
+
+/*
+Glyphs are tinted to match the two halves of the game's conchars: "white" text
+(chars 0-127) and "alt" text (char + 128). AVIAOZINHO 3 ships its own conchars
+with different colours from Quake's, so they are sampled from the wad lump:
+the average of each half's brighter pixels, skipping dark outline pixels.
+*/
+static float	glyph_rgb[2][3] = { { 1.0f, 1.0f, 1.0f }, { 0.82f, 0.58f, 0.32f } };
+static qboolean	glyph_rgb_sampled;
+
+static void Glyph_SampleColours (void)
+{
+	lumpinfo_t *info;
+	byte *data;
+	int half, i, maxlum, count, sum[3];
+
+	glyph_rgb_sampled = true;
+	data = (byte *) W_GetLumpName ("conchars", &info);
+	if (!data || info->size < 128 * 128)
+		return;
+
+	for (half = 0; half < 2; half++)
+	{
+		const byte *pixels = data + half * 64 * 128;
+
+		maxlum = 0;
+		for (i = 0; i < 64 * 128; i++)
+		{
+			const byte *c = (const byte *)&d_8to24table_conchars[pixels[i]];
+			if (pixels[i])
+				maxlum = q_max (maxlum, c[0] * 3 + c[1] * 6 + c[2]);
+		}
+		count = sum[0] = sum[1] = sum[2] = 0;
+		for (i = 0; i < 64 * 128; i++)
+		{
+			const byte *c = (const byte *)&d_8to24table_conchars[pixels[i]];
+			if (pixels[i] && (c[0] * 3 + c[1] * 6 + c[2]) * 4 >= maxlum * 3)
+			{
+				sum[0] += c[0];
+				sum[1] += c[1];
+				sum[2] += c[2];
+				count++;
+			}
+		}
+		if (count)
+			for (i = 0; i < 3; i++)
+				glyph_rgb[half][i] = sum[i] / (255.0f * count);
+	}
+}
+
+int Draw_UTF8CharWhite (int x, int y, const char **str)
+{
+	if (!glyph_rgb_sampled)
+		Glyph_SampleColours ();
+	return Draw_UTF8Char (x, y, str, glyph_rgb[0][0], glyph_rgb[0][1], glyph_rgb[0][2], 1.0f);
+}
+
+int Draw_UTF8CharAlt (int x, int y, const char **str)
+{
+	if (!glyph_rgb_sampled)
+		Glyph_SampleColours ();
+	return Draw_UTF8Char (x, y, str, glyph_rgb[1][0], glyph_rgb[1][1], glyph_rgb[1][2], 1.0f);
+}
+
+/* Drops cached glyphs, e.g. after switching languages. */
+void Draw_UTF8Reset (void)
+{
+	if (ft.pixels)
+		Atlas_Clear ();
+}
