 Draw_String -- johnfitz -- modified to call Draw_CharacterQuad
 ================
 */
+static qboolean Draw_HasUTF8 (const char *str)
+{
+	return UTF8_IsText (str);
+}
+
 void Draw_String (int x, int y, const char *str)
 {
 	//if (y <= -8) // woods enabled for more printing options #varmatchclock
 	//	return;			// totally off screen
 
+	if (Draw_HasUTF8 (str))
+	{	// localized text: glyphs need their own texture, so draw one character at a time
+		while (*str)
+		{
+			int w = Draw_UTF8CharWhite (x, y, &str);
+			if (!w)
+			{
+				Draw_Character (x, y, *str++);
+				w = 8;
+			}
+			x += w;
+		}
+		return;
+	}
+
 	GL_Bind (char_texture);
 	glBegin (GL_QUADS);
 
@@ -754,6 +774,29 @@ void Draw_StringRGBA (int x, int y, const char* str, plcolour_t c, float alpha)
 	//if (y <= -8) // woods enabled for more printing options #varmatchclock
 	//	return;			// totally off screen
 
+	if (Draw_HasUTF8 (str))
+	{	// localized text: one character at a time, glyphs use their own texture
+		float r = 1, g = 1, b = 1;
+		if (c.type == 2)
+			r = c.rgb[0] / 255.f, g = c.rgb[1] / 255.f, b = c.rgb[2] / 255.f;
+		else
+		{
+			byte* pal = (byte*)&d_8to24table[(c.basic << 4) + 8];
+			r = pal[0] / 255.f, g = pal[1] / 255.f, b = pal[2] / 255.f;
+		}
+		while (*str)
+		{
+			int w = Draw_UTF8Char (x, y, &str, r, g, b, alpha);
+			if (!w)
+			{
+				Draw_CharacterRGBA (x, y, *str++, c, alpha);
+				w = 8;
+			}
+			x += w;
+		}
+		return;
+	}
+
 	glEnable(GL_BLEND);
 
 	if (c.type == 2)
