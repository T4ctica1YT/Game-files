+		Con_DrawTextLine (v, text, alpha, true); // woods #confade
 
 		v += 8;
 
@@ -3045,8 +3077,7 @@ void Con_DrawConsole (int lines, qboolean drawinput)
 			j = 0;
 		text = con_text + (j % con_totallines)*con_linewidth;
 
-		for (x = 0; x < con_linewidth; x++)
-			Draw_Character ( (x + 1)<<3, y, text[x]);
+		Con_DrawTextLine (y, text, 1, false);
 	}
 
