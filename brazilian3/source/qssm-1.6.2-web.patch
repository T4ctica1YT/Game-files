diff --git a/Quake/web/pre.js b/Quake/web/pre.js
new file mode 100644
index 00000000..a7b5805d
--- /dev/null
+++ b/Quake/web/pre.js
@@ -0,0 +1,194 @@
+// pre.js -- browser filesystem for the AVIAOZINHO 3 web build.
+//
+// /game     read-only game data (Steam install layout), filled from data/manifest.json
+//             * small files and paks are downloaded before the engine starts
+//             * maps, music, fonts and demos are zero-length placeholders that
+//               web_port.c downloads on first open (Module.webFetchLazy)
+// /persist  the engine's "userdir": config.cfg, saves, screenshots.
+//             Backed by IndexedDB so it survives page reloads.
+//
+// Downloads go through the Cache API when available, so each file is fetched once.
+
+Module.dataBase = Module.dataBase || 'data/';
+
+(function () {
+  const LAZY_BUDGET = 320 * 1024 * 1024; // bytes of streamed files kept in memory
+  let cache = null;
+  let lazyLoaded = []; // LRU of {node, size}, oldest first
+  let lazyBytes = 0;
+
+  function urlFor(path) {
+    return Module.dataBase + path.split('/').map(encodeURIComponent).join('/');
+  }
+
+  async function openCache(version) {
+    if (!('caches' in self)) return null;
+    try {
+      const name = 'aviaozin3-data-' + version;
+      for (const key of await caches.keys())
+        if (key.startsWith('aviaozin3-data-') && key !== name) await caches.delete(key);
+      return await caches.open(name);
+    } catch (e) {
+      return null; // e.g. insecure context or storage disabled
+    }
+  }
+
+  async function fetchBytes(path, onBytes) {
+    const url = urlFor(path);
+    if (cache) {
+      const hit = await cache.match(url);
+      if (hit) {
+        const buf = new Uint8Array(await hit.arrayBuffer());
+        onBytes && onBytes(buf.length);
+        return buf;
+      }
+    }
+    const resp = await fetch(url);
+    if (!resp.ok) throw new Error('HTTP ' + resp.status + ' for ' + path);
+    const total = +resp.headers.get('Content-Length') || 0;
+    let buf;
+    if (resp.body && resp.body.getReader) {
+      const reader = resp.body.getReader();
+      const chunks = [];
+      let got = 0;
+      for (;;) {
+        const { done, value } = await reader.read();
+        if (done) break;
+        chunks.push(value);
+        got += value.length;
+        onBytes && onBytes(value.length);
+      }
+      buf = new Uint8Array(got);
+      let off = 0;
+      for (const c of chunks) { buf.set(c, off); off += c.length; }
+      if (total && got !== total) throw new Error('Truncated download for ' + path);
+    } else {
+      buf = new Uint8Array(await resp.arrayBuffer());
+      onBytes && onBytes(buf.length);
+    }
+    if (cache) {
+      try { await cache.put(url, new Response(buf)); } catch (e) { /* quota: keep going */ }
+    }
+    return buf;
+  }
+
+  function mkdirs(path) {
+    let cur = '';
+    for (const part of path.split('/').slice(0, -1)) {
+      cur += '/' + part;
+      try { FS.mkdir(cur); } catch (e) { /* exists */ }
+    }
+  }
+
+  function nodeFor(path) {
+    try { return FS.lookupPath(path).node; } catch (e) { return null; }
+  }
+
+  function isOpen(node) {
+    for (const s of FS.streams) if (s && s.node === node) return true;
+    return false;
+  }
+
+  function evictLazy() {
+    while (lazyBytes > LAZY_BUDGET && lazyLoaded.length) {
+      const idx = lazyLoaded.findIndex(e => !isOpen(e.node));
+      if (idx < 0) return;
+      const [e] = lazyLoaded.splice(idx, 1);
+      const path = FS.getPath(e.node);
+      FS.writeFile(path, new Uint8Array(0)); // back to a placeholder
+      e.node.webLazyPath = e.dataPath;
+      lazyBytes -= e.size;
+    }
+  }
+
+  Module.webIsLazyPending = function (path) {
+    const node = nodeFor(path);
+    return !!(node && node.webLazyPath);
+  };
+
+  Module.webFetchLazy = async function (path) {
+    const node = nodeFor(path);
+    if (!node || !node.webLazyPath) return 1;
+    const dataPath = node.webLazyPath;
+    Module.onLazyStart && Module.onLazyStart(dataPath);
+    try {
+      const bytes = await fetchBytes(dataPath, n => Module.onLazyProgress && Module.onLazyProgress(n));
+      FS.writeFile(FS.getPath(node), bytes);
+      delete node.webLazyPath;
+      lazyLoaded.push({ node, size: bytes.length, dataPath });
+      lazyBytes += bytes.length;
+      evictLazy();
+      return 1;
+    } catch (e) {
+      console.error('Streaming ' + dataPath + ' failed:', e);
+      Module.onLazyError && Module.onLazyError(dataPath, e);
+      return 0;
+    } finally {
+      Module.onLazyEnd && Module.onLazyEnd(dataPath);
+    }
+  };
+
+  async function mountPersist() {
+    FS.mkdir('/persist');
+    FS.mount(IDBFS, {}, '/persist');
+    await new Promise(res => FS.syncfs(true, err => { if (err) console.warn('IDBFS load failed', err); res(); }));
+    let syncing = false;
+    Module.webSyncPersist = function () {
+      if (syncing) return;
+      syncing = true;
+      FS.syncfs(false, err => { syncing = false; if (err) console.warn('IDBFS save failed', err); });
+    };
+    // Players close the tab rather than quitting, so write config.cfg from here too.
+    // Never call into the engine while it is suspended waiting for a download.
+    function saveConfig() {
+      if (!Module._Web_SaveConfig) return;
+      if (typeof Asyncify !== 'undefined' && (Asyncify.state !== Asyncify.State.Normal || Asyncify.currData)) return;
+      try { Module._Web_SaveConfig(); } catch (e) { /* engine not running (quit or error) */ }
+    }
+    function saveAll() { saveConfig(); Module.webSyncPersist(); }
+    setInterval(Module.webSyncPersist, 3000);
+    setInterval(saveConfig, 30000);
+    addEventListener('pagehide', saveAll);
+    document.addEventListener('visibilitychange', () => { if (document.hidden) saveAll(); });
+  }
+
+  async function loadGameData() {
+    const manifest = await (await fetch(Module.dataBase + 'manifest.json', { cache: 'no-cache' })).json();
+    cache = await openCache(manifest.version);
+    FS.mkdir('/game');
+
+    const eager = [];
+    let eagerTotal = 0;
+    for (const [path, size, lazy] of manifest.files) {
+      const full = '/game/' + path;
+      mkdirs(full);
+      if (lazy) {
+        FS.writeFile(full, new Uint8Array(0));
+        FS.lookupPath(full).node.webLazyPath = path;
+      } else {
+        eager.push([path, size]);
+        eagerTotal += size;
+      }
+    }
+
+    let done = 0;
+    const report = n => { done += n; Module.onProgress && Module.onProgress(done, eagerTotal); };
+    let next = 0;
+    async function worker() {
+      while (next < eager.length) {
+        const [path] = eager[next++];
+        FS.writeFile('/game/' + path, await fetchBytes(path, report));
+      }
+    }
+    await Promise.all([worker(), worker(), worker(), worker()]);
+    FS.chdir('/game');
+  }
+
+  Module.preRun = Module.preRun || [];
+  Module.preRun.push(function () {
+    addRunDependency('aviaozin3-data');
+    Promise.all([mountPersist(), loadGameData()])
+      .then(() => removeRunDependency('aviaozin3-data'))
+      .catch(e => { Module.onFatal ? Module.onFatal(String(e && e.message || e)) : console.error(e); });
+  });
+})();
